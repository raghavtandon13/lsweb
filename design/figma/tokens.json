{
    "name": "LoanSparrow Design System",
    "version": "1.0.0",
    "date": "2026-09-10",
    "grid": 8,
    "breakpoints": { "mobile": 390, "desktop": 1440 },
    "fonts": {
        "sans": "Manrope",
        "serif": "Fraunces"
    },
    "colors": {
        "navy": "#0D3B3F",
        "navySoft": "#0A3033",
        "ink": "#101618",
        "muted": "#2C3538",
        "ivory": "#F7F8F8",
        "paper": "#FFFFFF",
        "line": "#D9E0E0",
        "danger": "#C24141",
        "sparkGold": "#E4B429",
        "sparkGoldDeep": "#C48A10",
        "sparkMint": "#1DB8AE",
        "sparkSky": "#3B9AD9",
        "sparkLeaf": "#2F9E6D",
        "sparkCoral": "#E07A5F",
        "sparkLilac": "#7B6CF6"
